# Runs at build time (see imgui_richmd_embed_files.cmake): OUT, SYMBOL, BASE_DIR, FILES
file(WRITE "${OUT}" "// Generated by imgui_richmd_embed_files: do not edit\n#include \"imgui_rich_md/imgui_md_host.h\"\n\nnamespace ImGuiMd\n{\n// declared extern first: a namespace-scope const would otherwise have internal linkage\nextern const EmbeddedAsset ${SYMBOL}[];\nextern const int ${SYMBOL}_count;\n")
set(entries "")
set(i 0)
foreach(f ${FILES})
    # Each file is stored gzipped (a raw gzip stream, inflated at load time with stb_image's zlib decoder)
    file(SIZE "${BASE_DIR}/${f}" size)
    set(gz "${OUT}.tmp.gz")
    file(ARCHIVE_CREATE OUTPUT "${gz}" PATHS "${BASE_DIR}/${f}" FORMAT raw COMPRESSION GZip)
    file(READ "${gz}" hex HEX)
    file(REMOVE "${gz}")
    string(LENGTH "${hex}" hex_length)
    math(EXPR compressed_size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    file(APPEND "${OUT}" "static const unsigned char data_${i}[] = {${bytes}};\n")
    string(APPEND entries "    { \"${f}\", data_${i}, ${size}, ${compressed_size} },\n")
    math(EXPR i "${i} + 1")
endforeach()
file(APPEND "${OUT}" "\nconst EmbeddedAsset ${SYMBOL}[] = {\n${entries}};\nconst int ${SYMBOL}_count = ${i};\n}\n")
