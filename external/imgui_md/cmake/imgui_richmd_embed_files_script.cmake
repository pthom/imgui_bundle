# Runs at build time (see imgui_richmd_embed_files.cmake): OUT, SYMBOL, BASE_DIR, FILES
file(WRITE "${OUT}" "// Generated by imgui_richmd_embed_files: do not edit\n#include \"imgui_md_wrapper/imgui_md_host.h\"\n\nnamespace ImGuiMd\n{\n// declared extern first: a namespace-scope const would otherwise have internal linkage\nextern const EmbeddedAsset ${SYMBOL}[];\nextern const int ${SYMBOL}_count;\n")
set(entries "")
set(i 0)
foreach(f ${FILES})
    file(READ "${BASE_DIR}/${f}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    file(APPEND "${OUT}" "static const unsigned char data_${i}[] = {${bytes}};\n")
    string(APPEND entries "    { \"${f}\", data_${i}, ${size} },\n")
    math(EXPR i "${i} + 1")
endforeach()
file(APPEND "${OUT}" "\nconst EmbeddedAsset ${SYMBOL}[] = {\n${entries}};\nconst int ${SYMBOL}_count = ${i};\n}\n")
