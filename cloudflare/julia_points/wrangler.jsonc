// The API of the points that users share in the Julia map demo. Recipes: `just --list` (group demos)
{
  "name": "imgui-bundle-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imgui_bundle_api",
      // The production database, made by `wrangler d1 create imgui_bundle_api` (wrangler dev uses a local one)
      "database_id": "17513825-b6ac-494f-9a03-ed385d4f9da6"
    }
  ]
}
