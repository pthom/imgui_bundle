// The API of the points that users share in the Julia map demo. Recipes: `just --list` (group demos)
{
  "name": "imgui-bundle-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imgui_bundle_julia_points",
      // The production database, made by `wrangler d1 create imgui_bundle_julia_points` (wrangler dev uses a local one)
      "database_id": "b186aa08-40be-4aa8-a3f7-205e586aeeaf"
    }
  ]
}
